rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return request.auth != null && userRole() == 'Admin';
    }

    // task #42: canonical statuts list (mirrors CANONICAL_STATUTS in src/lib/dossiers-data.ts)
    function canonicalStatuts() {
      return [
        'Création dossier',
        'Planification programmée avant',
        'Planification expertise avant',
        'Planification programmée en cours',
        'Planification expertise en cours',
        'Planification programmée après',
        'Planification expertise après',
        'Chiffrage en cours',
        'Accord',
        "Proposition d'accord",
        '2ème accord',
        "2ème proposition d'accord",
        '3ème accord',
        "3ème proposition d'accord",
        'Accord envoyé',
      ];
    }
    // task #42: true if s is one of the canonical statuts. Also accepts
    // dynamic uncapped ordinal labels (`Nème accord` / `Nème proposition d'accord`)
    // so 4ème+ writes from the uncapped status machine pass.
    function isValidStatut(s) {
      return canonicalStatuts().hasAny([s])
        || s.matches("^[0-9]+ème (accord|proposition d'accord)$");
    }
    // task #42: writer must be Admin or Directeur des opérations
    function canValidateDossier() {
      return request.auth != null
        && (userRole() == 'Admin' || userRole() == 'Directeur des opérations');
    }
    function canAssign() {
      return request.auth != null && (
        userRole() == 'Admin'
        || userRole() == 'Gestionnaire'
        || userRole() == 'Directeur'
        || userRole() == 'Directeur des opérations'
        || userRole() == 'Directeur technique'
      );
    }

    // Dropdown and Configuration Collections (signed-in users only)
    match /options_natures/{docId} { allow read, write: if request.auth != null; }
    match /options_statuts/{docId} { allow read, write: if request.auth != null; }
    match /options_types_mission/{docId} { allow read, write: if request.auth != null; }
    match /options_types_documents/{docId} { allow read, write: if request.auth != null; }
    match /options_roles/{docId} { allow read, write: if request.auth != null; }
    match /options_agents/{docId} { allow read, write: if request.auth != null; }
    match /options_types_dossier/{docId} { allow read, write: if request.auth != null; }
    match /options_rapport_operations/{docId} { allow read, write: if request.auth != null; }
    match /options_rapport_types_pieces/{docId} { allow read, write: if request.auth != null; }
    match /options_reparateur_types/{docId} { allow read, write: if request.auth != null; }
    match /options_mdo_types/{docId} { allow read, write: if request.auth != null; }
    match /compagnies/{docId} { allow read, write: if request.auth != null; }

    // Seed lock collection
    match /_seeds/{docId} {
      allow read, write: if request.auth != null;
    }

    match /dossiers/{dossierId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
      // task #42: statut must be in canonical list
      // task #42: directorValidated writes restricted to Admin / Directeur des opérations
      allow update: if request.auth != null
        && (
          !('statut' in request.resource.data.diff(resource.data).affectedKeys())
          || isValidStatut(request.resource.data.statut)
        )
        && (
          !('directorValidated' in request.resource.data.diff(resource.data).affectedKeys())
          || canValidateDossier()
        );
      // Planifications: assigning a mission requires Gestionnaire/Admin/Directeur
      match /planifications/{pid} {
        allow read: if request.auth != null;
        allow create: if canAssign();
        allow update, delete: if request.auth != null;
      }
      // All other subcollections (and nested docs under planifications):
      // auth-only, preserving existing behavior.
      match /{subColl}/{doc=**} {
        allow read: if request.auth != null;
        allow write, delete: if request.auth != null && subColl != 'planifications';
      }
    }
    match /location_requests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.agentUid == request.auth.uid || canAssign());
      allow create: if canAssign()
        && request.resource.data.agentUid is string;
      allow update, delete: if isAdmin();
    }
    match /chiffreurs/{id} {
      allow read, write: if request.auth != null;
    }
    match /chiffrages/{id} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId} {
      // Reads: public. The login page queries `users` by nomLowercase BEFORE
      // the caller authenticates, to look up the email for name-based login.
      // Requiring auth here breaks that pre-auth lookup and locks every user
      // out. Public read is the historical behavior; the genuinely sensitive
      // change in this rule block is the write restrictions below (no
      // self-promote to Admin, owner-only updates, Admin-only delete).
      // FOLLOW-UP: migrate the login lookup to a callable Cloud Function so
      // we can tighten reads back to `request.auth != null` without breaking
      // the login UX.
      allow read: if true;
      // Create: self-signup only, and the new doc must NOT contain a role
      // field (admins assign roles via update; self-signup cannot self-promote).
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !('role' in request.resource.data.keys());
      // Update: Admin can change anything; otherwise the user can update their
      // own doc as long as the role field is not modified (allows updates that
      // simply don't touch role: displayName, fcmTokens, currentSessionId, ...).
      allow update: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == userId
          && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        );
      // Delete: Admin only.
      allow delete: if isAdmin();
    }
    // Stamps: per-account import + delete; admin oversight via the
    // /parametres/tampons page (admin can read+modify all). Reads stay open
    // so the admin page's listing query works; the picker UI filters
    // client-side to the user's own stamps via useStamps({ mineOnly: true }).
    match /stamps/{stampId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
