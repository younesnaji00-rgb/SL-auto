rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return request.auth != null && userRole() == 'Admin';
    }

    // Dropdown and Configuration Collections (Publicly Readable, Authenticated Write)
    match /options_natures/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_statuts/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_types_mission/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_types_documents/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_roles/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_agents/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_types_dossier/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_rapport_operations/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_rapport_types_pieces/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_reparateur_types/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_mdo_types/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /compagnies/{docId} { allow read: if true; allow write: if request.auth != null; }

    // Seed lock collection
    match /_seeds/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /dossiers/{dossierId} {
      allow read, write, delete: if true;
      match /{allSubcollections=**} {
        allow read, write, delete: if true;
      }
    }
    match /chiffreurs/{id} {
      allow read, write: if true;
    }
    match /chiffrages/{id} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    // task #6 — stamps collection; read: any auth, write: Admin only
    match /stamps/{stampId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
