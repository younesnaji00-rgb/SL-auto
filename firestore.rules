rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return request.auth != null && userRole() == 'Admin';
    }

    // task #42: canonical statuts list (mirrors CANONICAL_STATUTS in src/lib/dossiers-data.ts)
    function canonicalStatuts() {
      return [
        'Création dossier',
        'Planification programmée avant',
        'Planification expertise avant',
        'Planification programmée en cours',
        'Planification expertise en cours',
        'Planification programmée après',
        'Planification expertise après',
        'Chiffrage en cours',
        'Accord',
        "Proposition d'accord",
        '2ème accord',
        "2ème proposition d'accord",
        '3ème accord',
        "3ème proposition d'accord",
        'Accord envoyé',
      ];
    }
    // task #42: true if s is one of the canonical statuts
    function isValidStatut(s) {
      return canonicalStatuts().hasAny([s]);
    }
    // task #42: writer must be Admin or Directeur des opérations
    function canValidateDossier() {
      return request.auth != null
        && (userRole() == 'Admin' || userRole() == 'Directeur des opérations');
    }

    // Dropdown and Configuration Collections (Publicly Readable, Authenticated Write)
    match /options_natures/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_statuts/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_types_mission/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_types_documents/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_roles/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_agents/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_types_dossier/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_rapport_operations/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_rapport_types_pieces/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_reparateur_types/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /options_mdo_types/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /compagnies/{docId} { allow read: if true; allow write: if request.auth != null; }

    // Seed lock collection
    match /_seeds/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /dossiers/{dossierId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
      // task #42: statut must be in canonical list
      // task #42: directorValidated writes restricted to Admin / Directeur des opérations
      allow update: if
        (
          !('statut' in request.resource.data.diff(resource.data).affectedKeys())
          || isValidStatut(request.resource.data.statut)
        )
        && (
          !('directorValidated' in request.resource.data.diff(resource.data).affectedKeys())
          || canValidateDossier()
        );
      match /{allSubcollections=**} {
        allow read, write, delete: if true;
      }
    }
    match /chiffreurs/{id} {
      allow read, write: if true;
    }
    match /chiffrages/{id} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    // Stamps: per-account import + delete; admin oversight via the
    // /parametres/tampons page (admin can read+modify all). Reads stay open
    // so the admin page's listing query works; the picker UI filters
    // client-side to the user's own stamps via useStamps({ mineOnly: true }).
    match /stamps/{stampId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
