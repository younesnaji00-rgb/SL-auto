# Demo (Canadian showcase) build configuration — Lionheart brand.
# Copied to .env.production by scripts/deploy-demo.ps1 just for the demo
# build, then deleted. NEVER commit a .env.production with these values:
# the firm's App Hosting build would pick them up.
NEXT_PUBLIC_BRAND=demo
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBHkCdHubNRcBEIYj4qA9rPDKmiBh6uFkk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=appraisio-demo-ca.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=appraisio-demo-ca
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=appraisio-demo-ca.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=964337881254
NEXT_PUBLIC_FIREBASE_APP_ID=1:964337881254:web:380c90fc0d95ae365c2467

# Public origin of the marketing site (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://lionheart-appraisal.com
# Cookieless analytics (Plausible). Leave unset to disable.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=lionheart-appraisal.com
# Set to true once public/site/team.jpg exists.
# NEXT_PUBLIC_SITE_TEAM_PHOTO=true
# Address published in /.well-known/security.txt for vulnerability reports.
# Defaults to the brand's companyEmail — for the demo brand that is a
# fictitious address, so set a real, monitored mailbox here before deploying.
SECURITY_CONTACT_EMAIL=info@lionheart-appraisal.com
